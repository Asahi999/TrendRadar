<resources>
    <string name="app_name">微信群发</string>
    <string name="accessibility_description">在你点开始并确认名单之后，打开本机微信的通讯录，读取屏幕上的好友显示名，跳过你设定的排除词，再在单聊输入框填入你写的文字并点发送。不会在后台自己发，也不会导出通讯录。</string>
    <string name="home_subtitle">只向通讯录里的好友单聊发送。点开始并确认名单后才会发。</string>
    <string name="status_a11y_on">无障碍：已开启</string>
